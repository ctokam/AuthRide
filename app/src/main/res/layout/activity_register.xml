<?xml version="1.0" encoding="utf-8"?>
<!-- Οθόνη Εγγραφής. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/screen_padding">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="@dimen/logo_width"
            android:layout_height="@dimen/logo_height"
            android:layout_marginTop="@dimen/space_m"
            android:contentDescription="@string/logo_desc"
            android:src="@drawable/authride_logo" />

        <TextView
            style="@style/ScreenTitle"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="@dimen/space_l"
            android:text="@string/register_title" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/card_corner"
            app:cardElevation="@dimen/card_elevation"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/InputLabel"
                    android:text="@string/label_name" />

                <EditText
                    android:id="@+id/et_name"
                    style="@style/AppEditText"
                    android:hint="@string/hint_name"
                    android:inputType="textPersonName" />

                <TextView
                    style="@style/InputLabel"
                    android:text="@string/label_email" />

                <EditText
                    android:id="@+id/et_email"
                    style="@style/AppEditText"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress" />

                <TextView
                    style="@style/InputLabel"
                    android:text="@string/label_password" />

                <EditText
                    android:id="@+id/et_password"
                    style="@style/AppEditText"
                    android:hint="@string/hint_password_register"
                    android:inputType="textPassword"
                    android:layout_marginBottom="@dimen/space_l" />

                <Button
                    android:id="@+id/btn_register"
                    style="@style/PrimaryButton"
                    android:text="@string/btn_register" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_go_to_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_l"
            android:padding="@dimen/space_s"
            android:text="@string/go_to_login"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/label_text"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>